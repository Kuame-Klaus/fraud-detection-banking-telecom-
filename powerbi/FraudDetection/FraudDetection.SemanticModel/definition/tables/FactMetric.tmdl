	partition FactMetric = m
		mode: import
		source =
				let
				    Source = Results,
				    Filtered = Table.SelectRows(Source, each [record_type] = "metric"),
				    Kept = Table.SelectColumns(Filtered, {"run_id", "stack", "domain", "dataset_id", "scenario", "model", "rule_id", "split", "metric", "value", "alert_rate", "train_rows", "sample_method", "note", "runtime_seconds"}),
				    Add_scenario_key = Table.AddColumn(Kept, "scenario_key", each (if [domain] = null then "" else [domain]) & "|" & (if [scenario] = null then "" else [scenario]), type text)
				in
				    Add_scenario_key
