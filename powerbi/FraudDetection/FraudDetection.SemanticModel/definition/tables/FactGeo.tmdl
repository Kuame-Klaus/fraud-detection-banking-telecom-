		annotation SummarizationSetBy = Automatic

	partition FactGeo = m
		mode: import
		source =
				let
				    Source = Results,
				    Filtered = Table.SelectRows(Source, each [record_type] = "geo"),
				    Kept = Table.SelectColumns(Filtered, {"run_id", "stack", "domain", "dataset_id", "month", "note", "route", "cell_id", "latitude", "longitude", "geo_minutes", "geo_settled_minutes"}),
				    Add_dataset_key = Table.AddColumn(Kept, "dataset_key", each (if [domain] = null then "" else [domain]) & "|" & (if [dataset_id] = null then "" else [dataset_id]), type text)
				in
				    Add_dataset_key
