	column dataset_key
		dataType: string
		isHidden
		lineageTag: 51c1bac4-15d7-58fd-9778-49b707750acb
		summarizeBy: none
		sourceColumn: dataset_key

		annotation SummarizationSetBy = Automatic

	partition FactBenford = m
		mode: import
		source =
				let
				    Source = Results,
				    Filtered = Table.SelectRows(Source, each [record_type] = "benford"),
				    Kept = Table.SelectColumns(Filtered, {"run_id", "stack", "domain", "dataset_id", "first_digit", "observed_count", "expected_share"}),
				    Add_dataset_key = Table.AddColumn(Kept, "dataset_key", each (if [domain] = null then "" else [domain]) & "|" & (if [dataset_id] = null then "" else [dataset_id]), type text)
				in
				    Add_dataset_key
