	partition FactDrift = m
		mode: import
		source =
				let
				    Source = Results,
				    Filtered = Table.SelectRows(Source, each [record_type] = "drift"),
				    Kept = Table.SelectColumns(Filtered, {"run_id", "stack", "domain", "model", "month", "score_band", "band_share", "value"})
				in
				    Kept
