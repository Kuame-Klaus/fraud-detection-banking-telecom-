	partition FactScore = m
		mode: import
		source =
				let
				    Source = Results,
				    Filtered = Table.SelectRows(Source, each [record_type] = "score"),
				    Kept = Table.SelectColumns(Filtered, {"run_id", "stack", "domain", "dataset_id", "scenario", "model", "rule_id", "split", "record_id", "entity_id", "entity_type", "event_timestamp", "month", "score", "threshold", "predicted_label", "true_label", "true_scenario", "amount", "currency"}),
				    Add_scenario_key = Table.AddColumn(Kept, "scenario_key", each (if [domain] = null then "" else [domain]) & "|" & (if [scenario] = null then "" else [scenario]), type text),
				    AddDate = Table.AddColumn(Add_scenario_key, "event_date", each if [event_timestamp] = null then null else DateTime.Date(DateTimeZone.RemoveZone(DateTimeZone.ToUtc([event_timestamp]))), type date),
				    AddHour = Table.AddColumn(AddDate, "HourOfDay", each if [event_timestamp] = null then null else Time.Hour(DateTimeZone.RemoveZone(DateTimeZone.ToUtc([event_timestamp]))), Int64.Type),
				    AddWeekdayNumber = Table.AddColumn(AddHour, "WeekdayNumber", each if [event_date] = null then null else Date.DayOfWeek([event_date], Day.Monday) + 1, Int64.Type),
				    AddWeekday = Table.AddColumn(AddWeekdayNumber, "Weekday", each if [event_date] = null then null else Date.DayOfWeekName([event_date], "en-US"), type text)
				in
				    AddWeekday
