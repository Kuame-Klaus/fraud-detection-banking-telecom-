		summarizeBy: none
		sourceColumn: [WeekdayNumber]

		annotation SummarizationSetBy = Automatic

	partition DimDate = calculated
		mode: import
		source = ADDCOLUMNS ( CALENDAR ( MIN ( FactScore[event_date] ), MAX ( FactScore[event_date] ) ), "Month", FORMAT ( [Date], "yyyy-MM" ), "Weekday", FORMAT ( [Date], "dddd" ), "WeekdayNumber", WEEKDAY ( [Date], 2 ) )
