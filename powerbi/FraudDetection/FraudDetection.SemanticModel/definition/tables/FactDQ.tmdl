		annotation SummarizationSetBy = Automatic

	partition FactDQ = m
		mode: import
		source =
				let
				    Source = Results,
				    Filtered = Table.SelectRows(Source, each [record_type] = "dq"),
				    Kept = Table.SelectColumns(Filtered, {"run_id", "stack", "domain", "dataset_id", "month", "step", "check_name", "expected", "observed", "passed", "note"}),
				    Add_dataset_key = Table.AddColumn(Kept, "dataset_key", each (if [domain] = null then "" else [domain]) & "|" & (if [dataset_id] = null then "" else [dataset_id]), type text)
				in
				    Add_dataset_key
