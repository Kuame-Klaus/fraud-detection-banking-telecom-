		annotation SummarizationSetBy = Automatic

	partition FactThreshold = m
		mode: import
		source =
				let
				    Source = Results,
				    Filtered = Table.SelectRows(Source, each [record_type] = "threshold"),
				    Kept = Table.SelectColumns(Filtered, {"run_id", "stack", "domain", "scenario", "model", "threshold", "threshold_change_pct", "alert_count", "detected_count"}),
				    Add_scenario_key = Table.AddColumn(Kept, "scenario_key", each (if [domain] = null then "" else [domain]) & "|" & (if [scenario] = null then "" else [scenario]), type text)
				in
				    Add_scenario_key
