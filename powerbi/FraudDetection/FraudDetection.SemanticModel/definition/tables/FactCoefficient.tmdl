	partition FactCoefficient = m
		mode: import
		source =
				let
				    Source = Results,
				    Filtered = Table.SelectRows(Source, each [record_type] = "coefficient"),
				    Kept = Table.SelectColumns(Filtered, {"run_id", "stack", "domain", "dataset_id", "model", "step", "note", "feature", "coefficient", "odds_ratio"})
				in
				    Kept
