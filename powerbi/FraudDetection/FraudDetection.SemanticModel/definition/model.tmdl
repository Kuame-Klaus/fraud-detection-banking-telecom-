model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["pDataSource", "pLocalFolder", "pBaseUrl", "Results", "FactScore", "FactMetric", "FactDQ", "FactCoverage", "FactThreshold", "FactDrift", "FactAgreement", "FactEdge", "FactBenford", "FactGeo", "FactRun", "FactPRCurve", "FactCoefficient", "DimDomain", "DimStack", "DimModel", "DimDataset", "DimScenario", "DimMonth", "Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table FactScore
ref table FactMetric
ref table FactDQ
ref table FactCoverage
ref table FactThreshold
ref table FactDrift
ref table FactAgreement
ref table FactEdge
ref table FactBenford
ref table FactGeo
ref table FactRun
ref table FactPRCurve
ref table FactCoefficient
ref table DimDomain
ref table DimStack
ref table DimModel
ref table DimDataset
ref table DimScenario
ref table DimMonth
ref table Measures
ref table DimDate
ref table 'Threshold change'
